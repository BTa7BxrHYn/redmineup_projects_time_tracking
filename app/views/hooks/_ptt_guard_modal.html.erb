<%#
  Shared close/archive guard modal overlay.
  Included by:
    - hooks/_ptt_close_guard.html.erb (project show page)
    - projects/_list.html.erb admin branch (admin/projects list)
  The JS reads .ptt-close-guard-text to set the message before displaying.
%>
<div id="ptt-close-guard-modal" class="ptt-modal-overlay" style="display:none;">
  <div class="ptt-modal" role="dialog" aria-modal="true">
    <h3 class="ptt-modal-title"><%= l(:ptt_close_guard_title) %></h3>
    <p class="ptt-close-guard-text"></p>
    <p class="ptt-modal-buttons">
      <button type="button" class="button" onclick="pttHideGuardModal()"><%= l(:ptt_button_ok) %></button>
    </p>
  </div>
</div>
