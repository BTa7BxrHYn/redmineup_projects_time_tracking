<%
  budget_cf_id = ptt_budget_custom_field_id

  if budget_cf_id && User.current.allowed_to?(:view_time_entries, @project)
    ptt_budget = ptt_budget_for_project(@project)

    if ptt_budget && ptt_budget > 0
      ptt_project_issues = ptt_issues_data_for_project(@project)
      ptt_e_total = ptt_project_issues[:estimated]
      ptt_e_closed = ptt_project_issues[:closed_estimated]
      ptt_spent = ptt_time_spent_for_project(@project)
      ptt_metrics = project_metrics(ptt_budget, ptt_project_issues, ptt_spent)

      # History data.
      # In "show recent" mode: load LIMIT+1 rows to detect truncation without COUNT.
      # In "show all" mode:   load MAX+1 rows; if more arrive, show a notice instead
      #                       of a silent hard cutoff — still no separate COUNT query.
      ptt_history_limit = ProjectsTimeTrackingHelper::PTT_HISTORY_LIMIT
      ptt_history_max   = ProjectsTimeTrackingHelper::PTT_HISTORY_MAX
      ptt_show_all = params[:ptt_show_all_history].to_s == '1'
      base_query = @project.ptt_histories.sorted.includes(:user)

      if ptt_show_all
        # Load one extra record to detect whether the result was truncated
        histories_raw = base_query.limit(ptt_history_max + 1).to_a
        ptt_truncated = histories_raw.size > ptt_history_max
        histories_to_show = ptt_truncated ? histories_raw.take(ptt_history_max) : histories_raw
        ptt_total_count = histories_to_show.size
        ptt_has_more = false
      else
        # Load one extra to check if there are more
        histories_to_show = base_query.limit(ptt_history_limit + 1).to_a
        ptt_has_more = histories_to_show.size > ptt_history_limit
        histories_to_show = histories_to_show.take(ptt_history_limit) if ptt_has_more
        # When truncated, we still need the real total to label the "show all" link.
        # A single COUNT is unavoidable here; it is executed only in this branch.
        ptt_total_count = ptt_has_more ? base_query.count : histories_to_show.size
        ptt_truncated = false
      end

      grouped_histories = histories_to_show.group_by { |h| [h.user_id || h.id, h.created_at.to_i / 60] }
%>

<div style="display: flex; gap: 20px; align-items: flex-start; margin-bottom: 20px;">
  <!-- Budget metrics box (left) -->
  <div class="mypage-box" id="block-ptt-budget" style="flex: 1;">
    <h3><%= l(:ptt_budget_box_title) %></h3>
    <ul class="dashboard-list">
      <li class="ptt_budget">
        <span class="label"><%= l(:ptt_label_budget_b) %></span>: <strong><%= format_metric_hours(ptt_budget) %></strong> <%= l(:ptt_hours_short) %>
      </li>
      <li class="ptt_estimated">
        <span class="label"><%= l(:ptt_label_e_total) %></span>: <%= format_metric_hours(ptt_e_total) %> <%= l(:ptt_hours_short) %>
      </li>
      <li class="ptt_closed">
        <span class="label"><%= l(:ptt_label_e_closed) %></span>: <%= format_metric_hours(ptt_e_closed) %> <%= l(:ptt_hours_short) %>
      </li>
      <li class="ptt_spent">
        <span class="label"><%= l(:ptt_label_f) %></span>: <%= format_metric_hours(ptt_spent) %> <%= l(:ptt_hours_short) %>
      </li>
      <% if ptt_metrics %>
        <li class="ptt_progress" title="<%= h(metric_tooltip(:progress, ptt_metrics)) %>">
          <span class="label"><%= l(:ptt_metric_progress) %></span>: <%= format_metric_percent(ptt_metrics[:progress]) %>
        </li>
        <li class="ptt_spent_pct <%= metric_css_class(:spent, ptt_metrics[:spent]) %>" title="<%= h(metric_tooltip(:spent, ptt_metrics)) %>">
          <span class="label"><%= l(:ptt_metric_spent) %></span>: <%= format_metric_percent(ptt_metrics[:spent]) %>
        </li>
        <% if ptt_metrics[:incomplete] %>
          <li class="ptt_cpi" style="color: #999;">
            <span class="label"><%= l(:ptt_metric_cpi) %></span>: <em><%= l(:ptt_no_data) %></em>
          </li>
          <li class="ptt_eac" style="color: #999;">
            <span class="label"><%= l(:ptt_metric_eac) %></span>: <em><%= l(:ptt_no_data) %></em>
          </li>
          <li class="ptt_variance" style="color: #999;">
            <span class="label"><%= l(:ptt_metric_variance) %></span>: <em><%= l(:ptt_no_data) %></em>
          </li>
        <% else %>
          <li class="ptt_cpi <%= metric_css_class(:cpi, ptt_metrics[:cpi]) %>" title="<%= h(metric_tooltip(:cpi, ptt_metrics)) %>">
            <span class="label"><%= l(:ptt_metric_cpi) %></span>: <strong><%= number_with_precision(ptt_metrics[:cpi], precision: 2) %></strong>
          </li>
          <li class="ptt_eac" title="<%= h(metric_tooltip(:eac, ptt_metrics)) %>">
            <span class="label"><%= l(:ptt_metric_eac_forecast) %></span>: <%= format_metric_hours(ptt_metrics[:eac]) %> <%= l(:ptt_hours_short) %>
          </li>
          <li class="ptt_variance <%= metric_css_class(:variance, ptt_metrics[:variance]) %>" title="<%= h(metric_tooltip(:variance, ptt_metrics)) %>">
            <span class="label"><%= l(:ptt_metric_variance) %></span>: <%= ptt_metrics[:variance] >= 0 ? '+' : '' %><%= format_metric_hours(ptt_metrics[:variance]) %> <%= l(:ptt_hours_short) %> (<%= format_metric_percent(ptt_metrics[:variance_percent]) %>)
          </li>
        <% end %>
      <% end %>
    </ul>
  </div>

  <!-- History box (right) -->
  <div class="mypage-box" id="block-ptt-history" style="flex: 1;">
    <h3>
      <%= l(:ptt_history_title) %>
      <% if ptt_total_count > ptt_history_limit && !ptt_show_all %>
        <span style="font-weight: normal; font-size: 0.85em; color: #666;">
          <%= l(:ptt_history_recent_of, limit: ptt_history_limit, total: ptt_total_count) %>
        </span>
      <% end %>
    </h3>
    <div style="max-height: 250px; overflow-y: auto;">
      <% if ptt_total_count > 0 %>
        <% grouped_histories.each do |(user_id, time_key), entries| %>
          <% entry = entries.first %>
          <div style="margin-bottom: 10px; padding: 8px; background: #f9f9f9; border-left: 3px solid #ccc;">
            <div style="margin-bottom: 5px; color: #666; font-size: 0.9em;">
              <strong><%= entry.user ? link_to_user(entry.user) : l(:ptt_user_deleted) %></strong>
              — <%= format_time(entry.created_at) %>
            </div>
            <ul style="margin: 0; padding-left: 18px; font-size: 0.9em;">
              <% entries.each do |hist| %>
                <li>
                  <strong><%= hist.field_label %></strong>:
                  <% if hist.field_name == 'comment' %>
                    <div style="white-space: pre-wrap; word-break: break-word;"><%= h(hist.formatted_new_value) %></div>
                  <% else %>
                    <% if hist.old_value.present? %>
                      <del style="color: #900; background: #fdd;"><%= hist.formatted_old_value %></del> →
                    <% end %>
                    <ins style="color: #090; background: #dfd;"><%= hist.formatted_new_value %></ins>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
        <% if ptt_truncated %>
          <p style="text-align: center; margin: 5px 0 0; color: #666; font-style: italic;">
            <%= l(:ptt_history_truncated, count: ptt_history_max) %>
          </p>
        <% elsif ptt_total_count > ptt_history_limit %>
          <p style="text-align: center; margin: 5px 0 0;">
            <% if ptt_show_all %>
              <%= link_to l(:ptt_history_show_recent), project_path(@project), class: 'icon icon-collapsed' %>
            <% else %>
              <%= link_to l(:ptt_history_show_all, count: ptt_total_count), project_path(@project, ptt_show_all_history: '1'), class: 'icon icon-expanded' %>
            <% end %>
          </p>
        <% end %>
      <% else %>
        <p style="color: #999; font-style: italic; margin: 10px 0;"><%= l(:ptt_history_empty) %></p>
      <% end %>
    </div>
  </div>
</div>

<%
    end
  end
%>
